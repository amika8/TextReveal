<Window x:Class="TextReveal.Ui.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextReveal - Install"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <StackPanel Margin="24,22,24,20">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="38"
                    Height="38"
                    CornerRadius="11"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE721;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText"
                           Text="Install TextReveal"
                           FontSize="20"
                           FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <!-- What is installed -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="Installation" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="LocationText" Style="{StaticResource SectionDescriptionStyle}" />

                <CheckBox x:Name="DesktopCheckBox"
                          Margin="0,16,0,0"
                          Style="{StaticResource SettingsCheckBoxStyle}"
                          Content="Desktop shortcut" />

                <CheckBox x:Name="StartMenuCheckBox"
                          Margin="0,12,0,0"
                          Style="{StaticResource SettingsCheckBoxStyle}"
                          Content="Start menu shortcut" />

                <CheckBox x:Name="StartupCheckBox"
                          Margin="0,12,0,0"
                          Style="{StaticResource SettingsCheckBoxStyle}"
                          Content="Start with Windows" />

                <TextBlock x:Name="DetailsText" Style="{StaticResource SectionDescriptionStyle}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   MinHeight="18"
                   Margin="2,2,2,12"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnSkipClick" />

            <Button x:Name="InstallButton"
                    DockPanel.Dock="Right"
                    Content="Install"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnInstallClick" />
        </DockPanel>
    </StackPanel>
</Window>
