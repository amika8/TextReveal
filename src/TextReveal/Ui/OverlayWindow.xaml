<Window x:Class="TextReveal.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TextReveal.Ui.Controls"
        Title="TextReveal"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#050506"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        SizeChanged="OnOverlaySizeChanged">

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="#050506">

        <!-- 1. Frozen screen: the user keeps seeing exactly what was on screen. -->
        <Image x:Name="SnapshotImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 2. Yellow rectangles over every match (single visual, instant refresh). -->
        <controls:HighlightLayer x:Name="HighlightLayer" IsHitTestVisible="False" />

        <!-- 3. Drag selection: the box plus every word it contains. -->
        <controls:SelectionLayer x:Name="SelectionLayer" IsHitTestVisible="False" />

        <!-- 4. Copy button, shown next to a selection that contains text. -->
        <Border x:Name="CopyPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Button x:Name="CopyButton"
                    Style="{StaticResource PanelIconButtonStyle}"
                    Click="OnCopyButtonClick"
                    ToolTip="Copy the selected text (Ctrl+C)">
                <TextBlock x:Name="CopyIcon"
                           Text="&#xE8C8;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="15" />
            </Button>
        </Border>

        <!-- 5. Search panel, top right. -->
        <Border x:Name="SearchPanel"
                Width="520"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,44,72,0"
                Padding="14,8,8,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="17"
                           Margin="2,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />

                <Grid Grid.Column="1" MinHeight="30" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search the screen…"
                               FontSize="19"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{StaticResource SecondaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             TextChanged="OnSearchTextChanged" />
                </Grid>

                <Border x:Name="MatchCountBadge"
                        Grid.Column="2"
                        Margin="10,0,6,0"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Background="{StaticResource HoverBrush}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MatchCountText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>

                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Style="{StaticResource PanelIconButtonStyle}"
                        Click="OnCloseButtonClick"
                        ToolTip="Close (Esc)">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
